<Window x:Class="ScanDesk.ScannerManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Manage scanners" Width="560" SizeToContent="Height" MaxHeight="640" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}">
    <DockPanel Margin="22,18,22,18">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="Manage scanners" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="The default scanner is selected automatically when ScanDesk starts. Removed scanners stay hidden from the list until you add them back; nothing changes in Windows."/>
        </StackPanel>

        <Button DockPanel.Dock="Bottom" Style="{StaticResource AccentButton}" Height="36" Width="110" HorizontalAlignment="Right"
                Margin="0,16,0,0" Content="Done" IsDefault="True" Click="Done_Click"/>

        <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"
                   Text="No scanners found. Switch the printer on and press refresh in the main window."/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="ScannerList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Row" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                Padding="14,10" Margin="0,0,0,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="Info" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                </StackPanel>
                                <RadioButton Grid.Column="1" GroupName="DefaultScanner" Content="Default" VerticalAlignment="Center"
                                             VerticalContentAlignment="Center" Margin="14,0"
                                             IsChecked="{Binding IsDefault, Mode=TwoWay}" IsEnabled="{Binding IsVisible}"/>
                                <Button Grid.Column="2" x:Name="ToggleButton" Style="{StaticResource SoftButton}" Height="30" Width="96"
                                        Content="Remove" Click="Toggle_Click" ToolTip="Hide this scanner from the scanner list"/>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                <Setter TargetName="Info" Property="Opacity" Value="0.45"/>
                                <Setter TargetName="Row" Property="Background" Value="#F9FAFB"/>
                                <Setter TargetName="ToggleButton" Property="Content" Value="Add back"/>
                                <Setter TargetName="ToggleButton" Property="ToolTip" Value="Show this scanner in the scanner list again"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
