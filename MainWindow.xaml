<Window x:Class="ScanDesk.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScanDesk" Height="780" Width="1240" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}"
        Icon="Assets/ScanDesk.ico" AllowDrop="True" Drop="Window_Drop" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.InputBindings>
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Click"/>
    </Window.CommandBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="230"/>
        </Grid.ColumnDefinitions>

        <!-- Left: scan settings -->
        <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="22,20,22,20">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                    <TextBlock Text="{DynamicResource Label.Quality}" Style="{StaticResource FieldLabel}"/>
                    <ComboBox x:Name="QualityBox">
                        <ComboBoxItem Content="{DynamicResource Quality.Small}" Tag="65"/>
                        <ComboBoxItem Content="{DynamicResource Quality.Balanced}" Tag="85"/>
                        <ComboBoxItem Content="{DynamicResource Quality.Best}" Tag="95"/>
                    </ComboBox>
                    <Button x:Name="SaveButton" Style="{StaticResource AccentButton}" Margin="0,14,0,0" Click="Save_Click"
                            ToolTip="{DynamicResource Save.Tooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Save.Button}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <DockPanel Margin="0,12,0,0">
                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="{DynamicResource Language.Tooltip}"/>
                        <ComboBox x:Name="LanguageBox" Height="28" Padding="8,0" ToolTip="{DynamicResource Language.Tooltip}"
                                  SelectionChanged="Language_Changed"/>
                    </DockPanel>
                    <TextBlock Margin="0,10,0,0" FontSize="11.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center">
                        <Run x:Name="VersionRun" Text=""/>
                        <Run Text=" · "/>
                        <Hyperlink x:Name="CheckUpdatesLink" Click="CheckUpdates_Click" Foreground="{StaticResource AccentBrush}"><Run Text="{DynamicResource CheckUpdates}"/></Hyperlink>
                    </TextBlock>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-10,0">
                    <StackPanel Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentBrush}">
                                <TextBlock Text="&#xE8FE;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ScanDesk" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{DynamicResource App.Subtitle}" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="{DynamicResource Label.Scanner}" Style="{StaticResource FieldLabel}" Margin="0,24,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="ScannerBox"/>
                            <Button Grid.Column="1" x:Name="RefreshButton" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                    Content="&#xE72C;" ToolTip="{DynamicResource Refresh.Tooltip}" Click="Refresh_Click"/>
                            <Button Grid.Column="2" x:Name="ManageButton" Style="{StaticResource IconButton}" Margin="6,0,0,0"
                                    Content="&#xE713;" ToolTip="{DynamicResource Manage.Tooltip}" Click="Manage_Click"/>
                        </Grid>
                        <TextBlock x:Name="ScannerHint" Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap"
                                   Margin="0,5,0,0" Visibility="Collapsed"/>

                        <TextBlock Text="{DynamicResource Label.Color}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ColorBox">
                            <ComboBoxItem Content="{DynamicResource Color.Color}" Tag="Color"/>
                            <ComboBoxItem Content="{DynamicResource Color.Gray}" Tag="Grayscale"/>
                            <ComboBoxItem Content="{DynamicResource Color.BW}" Tag="BlackWhite"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Label.Resolution}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="DpiBox">
                            <ComboBoxItem Content="{DynamicResource Dpi.100}" Tag="100"/>
                            <ComboBoxItem Content="{DynamicResource Dpi.150}" Tag="150"/>
                            <ComboBoxItem Content="{DynamicResource Dpi.200}" Tag="200"/>
                            <ComboBoxItem Content="{DynamicResource Dpi.300}" Tag="300"/>
                            <ComboBoxItem Content="{DynamicResource Dpi.600}" Tag="600"/>
                            <ComboBoxItem Content="{DynamicResource Dpi.1200}" Tag="1200"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Label.Area}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="AreaBox">
                            <ComboBoxItem Content="{DynamicResource Area.A4}" Tag="A4"/>
                            <ComboBoxItem Content="{DynamicResource Area.Letter}" Tag="Letter"/>
                            <ComboBoxItem Content="{DynamicResource Area.A5}" Tag="A5"/>
                            <ComboBoxItem Content="{DynamicResource Area.Photo}" Tag="Photo10x15"/>
                            <ComboBoxItem Content="{DynamicResource Area.Full}" Tag="FullGlass"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Label.Correction}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="EnhanceBox">
                            <ComboBoxItem Content="{DynamicResource Correction.Document}" Tag="Document"/>
                            <ComboBoxItem Content="{DynamicResource Correction.Photo}" Tag="Photo"/>
                            <ComboBoxItem Content="{DynamicResource Correction.Off}" Tag="Off"/>
                        </ComboBox>

                        <TextBlock Text="{DynamicResource Label.Rotate}" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="RotateBox">
                            <ComboBoxItem Content="0°" Tag="0"/>
                            <ComboBoxItem Content="{DynamicResource Rotate.90}" Tag="90"/>
                            <ComboBoxItem Content="180°" Tag="180"/>
                            <ComboBoxItem Content="{DynamicResource Rotate.270}" Tag="270"/>
                        </ComboBox>

                        <CheckBox x:Name="DeskewBox" Margin="0,12,0,0" VerticalContentAlignment="Center">
                            <TextBlock Text="{DynamicResource Deskew}" TextWrapping="Wrap"/>
                        </CheckBox>

                        <Expander Header="{DynamicResource Advanced}" Margin="0,14,0,0" Foreground="{StaticResource MutedBrush}" FontWeight="SemiBold" FontSize="12">
                            <StackPanel Margin="0,6,0,0" TextElement.FontWeight="Normal" TextElement.Foreground="{StaticResource TextBrush}">
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=BrightnessSlider, StringFormat={}{0:+0;-0;0}}" Width="28" TextAlignment="Right"/>
                                    <TextBlock Text="{DynamicResource Brightness}"/>
                                </DockPanel>
                                <Slider x:Name="BrightnessSlider" Minimum="-50" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                <DockPanel Margin="0,8,0,0">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=ContrastSlider, StringFormat={}{0:+0;-0;0}}" Width="28" TextAlignment="Right"/>
                                    <TextBlock Text="{DynamicResource Contrast}"/>
                                </DockPanel>
                                <Slider x:Name="ContrastSlider" Minimum="-50" Maximum="50" IsSnapToTickEnabled="True" TickFrequency="5"/>
                                <Button Style="{StaticResource SoftButton}" Height="26" FontSize="12" HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Content="{DynamicResource Reset}" Click="ResetAdvanced_Click"/>
                            </StackPanel>
                        </Expander>

                        <Button x:Name="ScanButton" Style="{StaticResource AccentButton}" Margin="0,24,0,0" Click="Scan_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FE;" FontFamily="{StaticResource IconFont}" FontSize="16" VerticalAlignment="Center"/>
                                <TextBlock x:Name="ScanButtonText" Text="{DynamicResource Scan.Page}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{DynamicResource Scan.Hint}"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,0"/>

                        <Button Style="{StaticResource SoftButton}" Margin="0,16,0,0" Click="Import_Click" x:Name="ImportButton">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8E5;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Import.Button}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Center: preview -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border x:Name="UpdateBanner" Grid.Row="0" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8"
                    Padding="14,10" Margin="0,0,0,14" Visibility="Collapsed">
                <DockPanel>
                    <StackPanel x:Name="UpdateButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SoftButton}" Height="30" Content="{DynamicResource Update.WhatsNew}" Click="UpdateNotes_Click"/>
                        <Button Style="{StaticResource SoftButton}" Height="30" Margin="6,0,0,0" Content="{DynamicResource Update.Later}" Click="UpdateLater_Click"/>
                        <Button x:Name="InstallUpdateButton" Style="{StaticResource AccentButton}" Height="30" FontSize="13" Width="124"
                                Margin="6,0,0,0" Content="{DynamicResource Update.Install}" Click="InstallUpdate_Click"/>
                    </StackPanel>
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource IconFont}" FontSize="18" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateTitle" FontWeight="SemiBold" Text=""/>
                        <TextBlock x:Name="UpdateDetail" Foreground="{StaticResource MutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,6,0,0" Maximum="1" Visibility="Collapsed"
                                     Foreground="{StaticResource AccentBrush}" Background="#DBEAFE" BorderThickness="0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Row="1" Margin="2,0,2,12" MinHeight="32">
                <DockPanel x:Name="NormalHeader">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock x:Name="PreviewInfo" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                        <Button x:Name="UndoButton" Style="{StaticResource SoftButton}" Height="32" Click="Undo_Click" Visibility="Collapsed"
                                ToolTip="{DynamicResource Undo.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A7;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Undo}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="FitButton" Style="{StaticResource SoftButton}" Height="32" Margin="8,0,0,0" Click="Fit_Click"
                                ToolTip="{DynamicResource Fit.Tooltip}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{DynamicResource Fit.A4}" Tag="A4" Click="FitPaper_Click"/>
                                    <MenuItem Header="{DynamicResource Fit.Letter}" Tag="Letter" Click="FitPaper_Click"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE740;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Fit.Button}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="6,1,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="CropButton" Style="{StaticResource SoftButton}" Height="32" Margin="8,0,0,0" Click="Crop_Click"
                                ToolTip="{DynamicResource Crop.Tooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7A8;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Crop}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="PreviewTitle" Text="{DynamicResource Preview}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>
                <DockPanel x:Name="CropHeader" Visibility="Collapsed">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource SoftButton}" Height="32" Content="{DynamicResource Cancel}" Click="CropCancel_Click" ToolTip="{DynamicResource Crop.CancelTooltip}"/>
                        <Button x:Name="ApplyCropButton" Style="{StaticResource AccentButton}" Height="32" FontSize="13" Width="120" Margin="8,0,0,0"
                                Click="CropApply_Click" ToolTip="{DynamicResource Crop.ApplyTooltip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                                <TextBlock Text="{DynamicResource Crop.Apply}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="CropHint" Text="{DynamicResource Crop.HintStart}" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Grid>

            <Border Grid.Row="2" Background="#E5E7EB" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="24" RenderOptions.BitmapScalingMode="HighQuality"
                           SizeChanged="CropCanvas_SizeChanged">
                        <Image.Effect>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.18"/>
                        </Image.Effect>
                    </Image>
                    <Canvas x:Name="CropCanvas" Background="Transparent" Visibility="Collapsed" Cursor="Cross" ClipToBounds="True"
                            MouseLeftButtonDown="Crop_MouseDown" MouseMove="Crop_MouseMove" MouseLeftButtonUp="Crop_MouseUp"
                            SizeChanged="CropCanvas_SizeChanged">
                        <Path x:Name="CropShade" Fill="#99111827" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropOutline" Stroke="{StaticResource AccentBrush}" StrokeThickness="3" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropDashes" Stroke="White" StrokeThickness="1" StrokeDashArray="4 3" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropHandle0" Width="12" Height="12" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropHandle1" Width="12" Height="12" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropHandle2" Width="12" Height="12" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                        <Rectangle x:Name="CropHandle3" Width="12" Height="12" Fill="White" Stroke="{StaticResource AccentBrush}" StrokeThickness="2" IsHitTestVisible="False"/>
                        <Border x:Name="CropSizeLabel" Background="#E6111827" CornerRadius="4" Padding="7,3" IsHitTestVisible="False">
                            <TextBlock x:Name="CropSizeText" Foreground="White" FontSize="11.5"/>
                        </Border>
                    </Canvas>
                    <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8FE;" FontFamily="{StaticResource IconFont}" FontSize="48" Foreground="#9CA3AF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Empty.Title}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                        <TextBlock Text="{DynamicResource Empty.Line1}" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Empty.Line2}" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                    <Border x:Name="BusyOverlay" Background="#B3F3F4F6" Visibility="Collapsed">
                        <Border Background="White" CornerRadius="10" Padding="26,20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                            <StackPanel Width="260">
                                <TextBlock x:Name="BusyText" Text="{DynamicResource Busy.Scanning}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                <ProgressBar IsIndeterminate="True" Height="4" Margin="0,14,0,0" Foreground="{StaticResource AccentBrush}"
                                             BorderThickness="0" Background="#E5E7EB"/>
                            </StackPanel>
                        </Border>
                    </Border>
                </Grid>
            </Border>

            <DockPanel Grid.Row="3" Margin="2,12,2,0" x:Name="StatusBar">
                <Button x:Name="OpenFolderButton" DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="28"
                        Content="{DynamicResource OpenFolder}" Visibility="Collapsed" Click="OpenFolder_Click"/>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{DynamicResource Ready}"/>
            </DockPanel>
        </Grid>

        <!-- Right: pages -->
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,0,0,0">
            <DockPanel Margin="14,20,14,14">
                <DockPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                    <Button DockPanel.Dock="Right" Style="{StaticResource SoftButton}" Height="26" Padding="10,0" FontSize="12"
                            Content="{DynamicResource ClearAll}" Click="ClearAll_Click" x:Name="ClearButton"/>
                    <TextBlock x:Name="PagesHeader" Text="{DynamicResource Pages}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </DockPanel>

                <UniformGrid DockPanel.Dock="Bottom" Rows="1" Margin="0,10,0,0">
                    <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="{DynamicResource MoveUp}" Click="MoveUp_Click" x:Name="UpButton"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="{DynamicResource MoveDown}" Click="MoveDown_Click" x:Name="DownButton"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="{DynamicResource RotateLeft}" Click="RotateLeft_Click" x:Name="RotLeftButton">
                        <TextBlock Text="&#xE7AD;" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform><ScaleTransform ScaleX="-1"/></TextBlock.RenderTransform>
                        </TextBlock>
                    </Button>
                    <Button Style="{StaticResource IconButton}" Content="&#xE7AD;" ToolTip="{DynamicResource RotateRight}" Click="RotateRight_Click" x:Name="RotRightButton"/>
                    <Button Style="{StaticResource IconButton}" Content="&#xE74D;" ToolTip="{DynamicResource DeletePage}" Click="Delete_Click" x:Name="DeleteButton"
                            Foreground="#DC2626"/>
                </UniformGrid>

                <ListBox x:Name="PageList" BorderThickness="0" SelectionMode="Extended" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="PageList_SelectionChanged"
                         KeyDown="PageList_KeyDown" AllowDrop="True"
                         PreviewMouseLeftButtonDown="PageList_PreviewMouseLeftButtonDown" PreviewMouseMove="PageList_PreviewMouseMove"
                         Drop="PageList_Drop" DragOver="PageList_DragOver">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,8"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" CornerRadius="8" Padding="8" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#F3F4F6"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Border Background="White" HorizontalAlignment="Center" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <Image Source="{Binding Thumbnail}" MaxHeight="200" Stretch="Uniform"/>
                                </Border>
                                <TextBlock HorizontalAlignment="Center" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}">
                                    <Run Text="{DynamicResource Page}"/> <Run Text="{Binding Number, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
