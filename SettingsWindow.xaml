<Window x:Class="ScanDesk.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings.Title}" Width="760" Height="560" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="White"
        FontFamily="Segoe UI" FontSize="13" Foreground="{StaticResource TextBrush}">
    <Window.Resources>
        <Style x:Key="NavButton" TargetType="RadioButton">
            <Setter Property="GroupName" Value="SettingsNav"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="6" Padding="12,9" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,14"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Navigation -->
        <Border DockPanel.Dock="Left" Width="200" Background="#F3F4F6" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <StackPanel Margin="12,18,12,12">
                <TextBlock Text="{DynamicResource Settings.Title}" FontSize="17" FontWeight="Bold" Margin="12,0,0,14"/>
                <RadioButton x:Name="NavGeneral" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Settings.General}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavScanners" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="Scanners">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8FE;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Settings.Scanners}"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAbout" Style="{StaticResource NavButton}" Checked="Nav_Checked" Tag="About">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="{DynamicResource Menu.About}"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,12">
            <Button Style="{StaticResource AccentButton}" Height="34" Width="110" FontSize="13" HorizontalAlignment="Right"
                    Content="{DynamicResource Settings.Close}" IsCancel="True" IsDefault="True" Click="Close_Click"/>
        </Border>

        <Grid Margin="26,22,26,12">
            <!-- General -->
            <ScrollViewer x:Name="PageGeneral" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Settings.General}" Style="{StaticResource PageTitle}"/>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Language.Tooltip}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Settings.LanguageHint}" Style="{StaticResource Hint}" Margin="0,0,0,10"/>
                            <ComboBox x:Name="LanguageBox" Width="220" HorizontalAlignment="Left" SelectionChanged="Language_Changed"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Settings.Updates}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="AutoUpdateBox" VerticalContentAlignment="Center" Margin="0,4,0,0"
                                      Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed">
                                <TextBlock Text="{DynamicResource AutoUpdate}" TextWrapping="Wrap"/>
                            </CheckBox>
                            <TextBlock Text="{DynamicResource AutoUpdate.Tooltip}" Style="{StaticResource Hint}" Margin="22,4,0,12"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="CheckNowButton" Style="{StaticResource SoftButton}" Content="{DynamicResource Settings.CheckNow}"
                                        Click="CheckNow_Click"/>
                                <TextBlock x:Name="UpdateResult" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Scanners -->
            <DockPanel x:Name="PageScanners" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Settings.Scanners}" Style="{StaticResource PageTitle}"/>
                <TextBlock DockPanel.Dock="Top" Text="{DynamicResource Manage.Intro}" Style="{StaticResource Hint}" Margin="0,0,0,12"/>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button x:Name="SearchButton" Style="{StaticResource SoftButton}" Click="Search_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Settings.Search}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SoftButton}" Margin="8,0,0,0" Click="AddInWindows_Click"
                            ToolTip="{DynamicResource Settings.AddInWindowsHint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE710;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center"/>
                            <TextBlock Text="{DynamicResource Settings.AddInWindows}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="EmptyText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Visibility="Collapsed"
                           Text="{DynamicResource Manage.Empty}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="ScannerList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="Row" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8"
                                        Padding="14,10" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel x:Name="Info" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                        </StackPanel>
                                        <RadioButton Grid.Column="1" GroupName="DefaultScanner" Content="{DynamicResource Manage.Default}"
                                                     VerticalAlignment="Center" VerticalContentAlignment="Center" Margin="14,0"
                                                     IsChecked="{Binding IsDefault, Mode=TwoWay}" IsEnabled="{Binding IsVisible}"
                                                     Checked="Default_Checked"/>
                                        <Button Grid.Column="2" x:Name="ToggleButton" Style="{StaticResource SoftButton}" Height="30" MinWidth="96"
                                                Content="{DynamicResource Manage.Remove}" Click="Toggle_Click" ToolTip="{DynamicResource Manage.RemoveTooltip}"/>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHidden}" Value="True">
                                        <Setter TargetName="Info" Property="Opacity" Value="0.45"/>
                                        <Setter TargetName="Row" Property="Background" Value="#F9FAFB"/>
                                        <Setter TargetName="ToggleButton" Property="Content" Value="{DynamicResource Manage.AddBack}"/>
                                        <Setter TargetName="ToggleButton" Property="ToolTip" Value="{DynamicResource Manage.AddBackTooltip}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- About -->
            <ScrollViewer x:Name="PageAbout" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,18">
                        <Border Width="52" Height="52" CornerRadius="12" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="&#xE8FE;" FontFamily="{StaticResource IconFont}" FontSize="26" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ScanDesk" FontSize="22" FontWeight="Bold"/>
                            <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="{DynamicResource App.Subtitle}" Margin="0,0,0,6"/>
                    <TextBlock Text="{DynamicResource About.License}" Style="{StaticResource Hint}"/>
                    <TextBlock Text="Copyright © 2026 Jack Mutsers" Style="{StaticResource Hint}" Margin="0,2,0,18"/>
                    <WrapPanel>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Content="{DynamicResource About.Website}" Click="Link_Click"
                                Tag="https://github.com/Jack-Mutsers/ScanDesk"/>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Content="{DynamicResource About.Releases}" Click="Link_Click"
                                Tag="https://github.com/Jack-Mutsers/ScanDesk/releases"/>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Content="{DynamicResource Menu.Privacy}" Click="Link_Click"
                                Tag="https://github.com/Jack-Mutsers/ScanDesk/blob/main/PRIVACY.md"/>
                        <Button Style="{StaticResource SoftButton}" Margin="0,0,8,8" Content="{DynamicResource About.LicenseLink}" Click="Link_Click"
                                Tag="https://github.com/Jack-Mutsers/ScanDesk/blob/main/LICENSE"/>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
